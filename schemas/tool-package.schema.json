{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness JavaScript package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "description",
    "input_schema",
    "output",
    "permissions",
    "runtime",
    "entry"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,47}$"
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "category": {
      "enum": [
        "file",
        "web",
        "calculation",
        "datetime",
        "text",
        "other"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "\\S"
    },
    "input_schema": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "object"
        },
        "properties": {
          "type": "object"
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "output": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "permissions": {
      "$ref": "entry.schema.json#/$defs/permissions"
    },
    "runtime": {
      "const": "js"
    },
    "entry": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "test": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  }
}
